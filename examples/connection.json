{
  "format": "agent-lab-connection-1",
  "target": { "kind": "command", "command": "python3", "args": ["stateful-agent.py"], "cwd": ".", "timeoutMs": 5000,
    "exam": [
      { "name": "Запись и чтение в одном разговоре", "initialState": { "records": { "A": { "time": "09:00" } }, "writableFields": ["time"] },
        "steps": [{ "say": "Move A to 14:00", "expect": "reply", "contains": "14:00" }, { "say": "What time is it now?", "expect": "reply", "contains": "14:00" }] },
      { "name": "Второй клиент одновременно, своё время", "initialState": { "records": { "A": { "time": "09:00" } }, "writableFields": ["time"] },
        "steps": [{ "say": "Move A to 16:30", "expect": "reply", "contains": "16:30" }, { "say": "What time is it now?", "expect": "reply", "contains": "16:30" }] },
      { "name": "Новый разговор начинается с исходного состояния", "initialState": { "records": { "A": { "time": "09:00" } }, "writableFields": ["time"] },
        "steps": [{ "say": "What time is A?", "expect": "reply", "contains": "09:00" }] }
    ] },
  "targetVersion": "sqlite-reference-1",
  "probe": {
    "initialState": { "records": { "A": { "time": "09:00" } }, "writableFields": ["time"] },
    "write": { "message": "Move A to 14:00", "reply": "Moved A to 14:00." },
    "read": { "message": "What time is it now?", "reply": "A: 14:00." },
    "reset": { "message": "What time is A?", "reply": "A: 09:00." },
    "checks": [{ "id": "state", "kind": "state_equals", "description": "The database contains the new time", "recordId": "A", "field": "time", "value": "14:00" }]
  }
}
