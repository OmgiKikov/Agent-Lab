# LangWatch source and its local databases stay on this computer.
/langwatch/
/.local-archive/
/.agent-lab/
/node_modules/
/dist/
__pycache__/
/.env
/.DS_Store

# Exports and secrets from real conversations never enter this repository.
*.xlsx
*.jsonl
*.pem
*.key
*.p12

# Agent Lab demo: local environment and real-conversation data.
/lab/.venv/
/lab/data/
/lab/.workshop-src/
/certs/

# Earlier experiments (LangWatch, review UI, old scripts): kept on disk, not in the repository.
/langwatch-custom/
/source-tests/
/review-ui/
/tests/
/skills/
/patches/
/config/
/.gitkeep
/scripts/*
!/scripts/pi-model-proxy.py
/docs/*
!/docs/agent-lab-demo.md
/future-agi-local/
/laminar-local/
/latitude-local/
/.raindrop/
/langwatch/
